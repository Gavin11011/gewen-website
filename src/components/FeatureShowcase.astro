---
const features = [
  {
    title: 'Markdown 阅读器',
    desc: '专为 Markdown 格式打造的阅读引擎，完美渲染标题、列表、代码块等丰富排版元素，带来如同纸质书般的沉浸体验。',
    points: ['精美排版渲染', '章节化内容组织', '舒适的阅读字体'],
    illustration: 'reader',
  },
  {
    title: '智能书架',
    desc: '你的专属数字书房。一键收藏心仪书籍，智能分类管理，阅读进度实时同步，随时回到上次阅读的位置。',
    points: ['个人收藏管理', '阅读进度同步', '分类浏览发现'],
    illustration: 'bookshelf',
  },
  {
    title: '阅读社区',
    desc: '与志同道合的书友交流心得。发表读后感、评论精彩章节，在交流中碰撞思想的火花。',
    points: ['书籍评论互动', '读书心得分享', '社区交流讨论'],
    illustration: 'community',
  },
];
---

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">功能亮点</h2>
      <p class="text-text-secondary max-w-xl mx-auto">每个细节都为更好的阅读体验而设计</p>
    </div>

    <div class="space-y-24">
      {features.map((feature, index) => (
        <div
          class:list={[
            'flex flex-col gap-10 items-center',
            index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse',
          ]}
          data-reveal
        >
          <!-- 插画区 -->
          <div class="flex-1 w-full">
            <div class="bg-brand-lighter rounded-2xl p-10 aspect-[4/3] flex items-center justify-center">
              {feature.illustration === 'reader' && (
                <svg viewBox="0 0 280 200" class="w-full max-w-[280px] text-brand" fill="none" stroke="currentColor" stroke-width="1.5">
                  {/* 打开的书 */}
                  <rect x="40" y="40" width="90" height="120" rx="4" fill="currentColor" opacity="0.1" stroke="currentColor" />
                  <rect x="150" y="40" width="90" height="120" rx="4" fill="currentColor" opacity="0.06" stroke="currentColor" />
                  <line x1="140" y1="35" x2="140" y2="165" stroke="currentColor" stroke-width="2" />
                  {/* 文字行 */}
                  <line x1="55" y1="65" x2="115" y2="65" stroke="currentColor" opacity="0.4" />
                  <line x1="55" y1="80" x2="105" y2="80" stroke="currentColor" opacity="0.3" />
                  <line x1="55" y1="95" x2="118" y2="95" stroke="currentColor" opacity="0.4" />
                  <line x1="55" y1="110" x2="100" y2="110" stroke="currentColor" opacity="0.3" />
                  <line x1="55" y1="125" x2="112" y2="125" stroke="currentColor" opacity="0.4" />
                  <line x1="165" y1="65" x2="225" y2="65" stroke="currentColor" opacity="0.3" />
                  <line x1="165" y1="80" x2="215" y2="80" stroke="currentColor" opacity="0.2" />
                  <line x1="165" y1="95" x2="228" y2="95" stroke="currentColor" opacity="0.3" />
                </svg>
              )}
              {feature.illustration === 'bookshelf' && (
                <svg viewBox="0 0 280 200" class="w-full max-w-[280px] text-brand" fill="none" stroke="currentColor" stroke-width="1.5">
                  {/* 书架 */}
                  <line x1="30" y1="170" x2="250" y2="170" stroke="currentColor" stroke-width="2" />
                  <line x1="30" y1="110" x2="250" y2="110" stroke="currentColor" stroke-width="2" />
                  {/* 上层书本 */}
                  <rect x="45" y="55" width="20" height="55" rx="2" fill="currentColor" opacity="0.15" stroke="currentColor" />
                  <rect x="70" y="45" width="22" height="65" rx="2" fill="currentColor" opacity="0.25" stroke="currentColor" />
                  <rect x="97" y="60" width="18" height="50" rx="2" fill="currentColor" opacity="0.1" stroke="currentColor" />
                  <rect x="120" y="50" width="24" height="60" rx="2" fill="currentColor" opacity="0.2" stroke="currentColor" />
                  <rect x="150" y="55" width="20" height="55" rx="2" fill="currentColor" opacity="0.12" stroke="currentColor" />
                  <rect x="175" y="48" width="22" height="62" rx="2" fill="currentColor" opacity="0.18" stroke="currentColor" />
                  {/* 下层书本 */}
                  <rect x="50" y="118" width="25" height="52" rx="2" fill="currentColor" opacity="0.2" stroke="currentColor" />
                  <rect x="80" y="125" width="20" height="45" rx="2" fill="currentColor" opacity="0.1" stroke="currentColor" />
                  <rect x="105" y="115" width="22" height="55" rx="2" fill="currentColor" opacity="0.15" stroke="currentColor" />
                  <rect x="135" y="120" width="18" height="50" rx="2" fill="currentColor" opacity="0.25" stroke="currentColor" />
                  {/* 植物装饰 */}
                  <circle cx="220" cy="140" r="20" fill="currentColor" opacity="0.08" />
                  <line x1="220" y1="160" x2="220" y2="170" stroke="currentColor" opacity="0.3" />
                </svg>
              )}
              {feature.illustration === 'community' && (
                <svg viewBox="0 0 280 200" class="w-full max-w-[280px] text-brand" fill="none" stroke="currentColor" stroke-width="1.5">
                  {/* 对话气泡 */}
                  <rect x="40" y="30" width="120" height="60" rx="12" fill="currentColor" opacity="0.1" stroke="currentColor" />
                  <path d="M70 90 L60 105 L85 90" fill="currentColor" opacity="0.1" stroke="currentColor" />
                  <line x1="60" y1="50" x2="140" y2="50" stroke="currentColor" opacity="0.3" />
                  <line x1="60" y1="65" x2="120" y2="65" stroke="currentColor" opacity="0.2" />
                  {/* 第二个对话气泡 */}
                  <rect x="120" y="100" width="130" height="55" rx="12" fill="currentColor" opacity="0.15" stroke="currentColor" />
                  <path d="M210 155 L220 170 L195 155" fill="currentColor" opacity="0.15" stroke="currentColor" />
                  <line x1="140" y1="118" x2="230" y2="118" stroke="currentColor" opacity="0.3" />
                  <line x1="140" y1="133" x2="210" y2="133" stroke="currentColor" opacity="0.2" />
                  {/* 小星标 */}
                  <circle cx="215" cy="45" r="6" fill="currentColor" opacity="0.15" />
                  <circle cx="235" cy="65" r="4" fill="currentColor" opacity="0.1" />
                </svg>
              )}
            </div>
          </div>

          <!-- 文字区 -->
          <div class="flex-1">
            <h3 class="text-2xl font-bold text-text-primary mb-4">{feature.title}</h3>
            <p class="text-text-secondary leading-relaxed mb-6">{feature.desc}</p>
            <ul class="space-y-3">
              {feature.points.map((point) => (
                <li class="flex items-center gap-3 text-text-primary">
                  <span class="w-5 h-5 bg-brand-lighter rounded-full flex items-center justify-center shrink-0">
                    <svg class="w-3 h-3 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
