---
const currentYear = new Date().getFullYear();
const footerLinks = [
  { label: '首页', href: '/' },
  { label: '功能介绍', href: '/features' },
  { label: '关于我们', href: '/about' },
  { label: '隐私政策', href: '/privacy' },
  { label: '用户协议', href: '/terms' },
];
---

<footer class="bg-footer text-gray-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- 品牌 -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <img src="/logo.png" alt="格文笔记" class="w-8 h-8 rounded-lg" />
          <span class="text-white font-semibold text-lg">格文笔记</span>
        </div>
        <p class="text-sm leading-relaxed">用书创造美好生活</p>
      </div>

      <!-- 导航链接 -->
      <div>
        <h3 class="text-white font-medium mb-4">导航</h3>
        <ul class="space-y-2">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- 联系信息 -->
      <div>
        <h3 class="text-white font-medium mb-4">联系我们</h3>
        <ul class="space-y-2 text-sm">
          <li>邮箱：support@gewennote.com</li>
          <li>地址：河北省廊坊市</li>
        </ul>
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="border-t border-gray-700 mt-8 pt-8 text-center text-sm">
      <p>&copy; {currentYear} 廊坊元云科技有限公司 | ICP备案号：待填写</p>
    </div>
  </div>
</footer>
