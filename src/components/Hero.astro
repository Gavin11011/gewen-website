<section class="relative overflow-hidden bg-gradient-to-br from-brand to-brand-light min-h-[600px] flex items-center">
  <!-- 装饰 SVG 元素 -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- 书页形状装饰 -->
    <svg class="absolute top-16 right-[10%] w-32 h-40 text-white/10 animate-float" viewBox="0 0 120 150" fill="currentColor">
      <path d="M10 0C10 0 0 10 0 25v100c0 15 10 25 10 25h50s10-10 10-25V25C70 10 60 0 60 0H10z" />
      <path d="M60 0c0 0 10 10 10 25v100c0 15-10 25-10 25h50s10-10 10-25V25C120 10 110 0 110 0H60z" opacity="0.6" />
    </svg>
    <svg class="absolute bottom-20 left-[5%] w-24 h-30 text-white/8 animate-float-delayed" viewBox="0 0 120 150" fill="currentColor">
      <path d="M10 0C10 0 0 10 0 25v100c0 15 10 25 10 25h50s10-10 10-25V25C70 10 60 0 60 0H10z" />
    </svg>
    <!-- 圆形装饰 -->
    <div class="absolute -top-20 -left-20 w-60 h-60 bg-white/5 rounded-full"></div>
    <div class="absolute -bottom-32 -right-16 w-80 h-80 bg-white/5 rounded-full"></div>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
      用书创造美好生活
    </h1>
    <p class="text-lg sm:text-xl text-white/85 max-w-2xl mx-auto mb-10 leading-relaxed">
      格文笔记是一款专注于优质阅读体验的应用，为你打造沉浸式的数字阅读空间，让每一次翻阅都成为一段美好时光。
    </p>
    <a
      href="/features"
      class="inline-flex items-center gap-2 bg-white text-brand px-8 py-3.5 rounded-full font-medium hover:bg-white/90 transition-colors shadow-lg"
    >
      了解更多
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>
