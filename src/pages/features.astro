---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import MemberCompare from '../components/MemberCompare.astro';
import Smartphone from '../icons/Smartphone.astro';
import Monitor from '../icons/Monitor.astro';
import Globe from '../icons/Globe.astro';
---

<BaseLayout title="功能介绍 - 格文笔记" description="了解格文笔记的核心功能：Markdown 阅读器、章节导航、个人书架、阅读进度同步、评论互动、阅读统计等。">
  <!-- 页头 -->
  <section class="bg-gradient-to-br from-brand to-brand-light pt-28 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">让阅读成为一种生活方式</h1>
      <p class="text-white/80 max-w-2xl mx-auto text-lg">
        格文笔记提供丰富的功能，帮助你更好地阅读、管理和分享书籍
      </p>
    </div>
  </section>

  <!-- 功能网格 -->
  <FeatureGrid />

  <!-- 会员对比 -->
  <MemberCompare />

  <!-- 多平台支持 -->
  <section class="py-20 bg-surface">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">多平台支持</h2>
      <p class="text-text-secondary max-w-xl mx-auto mb-12">
        无论你使用什么设备，格文笔记都能为你提供一致的阅读体验
      </p>

      <div class="flex flex-wrap items-center justify-center gap-10">
        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-brand">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-text-primary">iOS</span>
        </div>

        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-brand">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85-.29-.15-.65-.06-.83.22l-1.88 3.24a11.463 11.463 0 00-8.94 0L5.65 5.67c-.19-.29-.51-.38-.83-.22-.31.16-.43.54-.26.85L6.4 9.48A10.78 10.78 0 002 18h20a10.78 10.78 0 00-4.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z" />
            </svg>
          </div>
          <span class="text-sm font-medium text-text-primary">Android</span>
        </div>

        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-brand">
            <Globe class="w-8 h-8" />
          </div>
          <span class="text-sm font-medium text-text-primary">Web</span>
        </div>

        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center text-brand">
            <Monitor class="w-8 h-8" />
          </div>
          <span class="text-sm font-medium text-text-primary">桌面端</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
